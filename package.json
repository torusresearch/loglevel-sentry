{
  "name": "@toruslabs/loglevel-sentry",
  "version": "9.0.0",
  "description": "A package to allow logging and monitoring with sentry",
  "main": "dist/lib.cjs/index.js",
  "module": "dist/lib.esm/index.js",
  "unpkg": "dist/lib.esm/index.js",
  "jsdelivr": "dist/lib.esm/index.js",
  "types": "dist/lib.cjs/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "vp pack",
    "lint": "vp lint --fix",
    "fmt": "vp fmt",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "harden": "harden check --package-manager npm --level moderate",
    "prepack": "npm run build",
    "test:node": "vp test run --config ./test/configs/node.config.mts --coverage",
    "test:browsers": "vp test run --config ./test/configs/browsers.config.mts --coverage",
    "test": "npm run test:node && npm run test:browsers",
    "prepare": "husky"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@sentry/core": "^10.38.0",
    "loglevel": "^1.9.2"
  },
  "devDependencies": {
    "@lavamoat/harden": "^0.8.1",
    "@sentry/browser": "^10.38.0",
    "@sentry/node": "^10.38.0",
    "@toruslabs/config": "^5.0.0",
    "@toruslabs/oxlint-config-typescript": "^1.1.0",
    "@toruslabs/torus-scripts": "^9.0.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "vitest": "5.1.0"
  },
  "author": "Torus Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torusresearch/loglevel-sentry.git"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,json,md,yml,yaml}": [
      "vp fmt"
    ],
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "vp lint --fix"
    ]
  },
  "keywords": [
    "loglevel",
    "sentry",
    "torus"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/torusresearch/loglevel-sentry/issues"
  },
  "homepage": "https://github.com/torusresearch/loglevel-sentry#readme",
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0"
  }
}
